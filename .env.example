# ╔══════════════════════════════════════════════════════╗
# ║  GastroWise - Environment Variables                  ║
# ║  Copy file này thành .env.local và điền giá trị thật ║
# ║  KHÔNG BAO GIỜ commit .env.local lên git!            ║
# ╚══════════════════════════════════════════════════════╝

# === PUBLIC (browser có thể truy cập — prefix NEXT_PUBLIC_) ===

# URL của API Gateway — thay bằng URL thật khi có
NEXT_PUBLIC_API_GATEWAY_URL=

# Tên ứng dụng
NEXT_PUBLIC_APP_NAME=GastroWise

# Google Maps API Key (restricted key only)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# === PRIVATE (chỉ server-side — KHÔNG có prefix NEXT_PUBLIC_) ===

# Secret key cho server-side API calls
API_SECRET_KEY=

# JWT secret cho verify token (nếu cần SSR verify)
JWT_SECRET=
